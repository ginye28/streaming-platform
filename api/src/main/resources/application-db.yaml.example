# application-db.yaml 로 복사해서 사용하세요. (이 파일은 커밋되지 않습니다)
#
# 루트 docker-compose.yml 의 MySQL 을 쓸 거라면 이 파일을 만들 필요 없이
# mysql 프로필로 실행하면 됩니다: --spring.profiles.active=mysql
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/streaming?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: streaming
    password: change-me
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      # 표를 만들고 고치는 건 Flyway(db/migration) 담당이다.
      # Hibernate 는 엔티티와 실제 표가 맞는지 확인만 하고, 안 맞으면 기동을 멈춘다.
      ddl-auto: validate
    properties:
      hibernate:
        format_sql: true
    open-in-view: false
