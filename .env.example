# docker compose 가 이 파일 옆의 .env 를 자동으로 읽는다. 복사해서 값을 채운다:  cp .env.example .env
# .env 는 .gitignore 에 들어 있다. 실제 값은 저장소에 올리지 않는다.

# 필수(full 프로필). 32바이트 넘는 아무 문자열.
JWT_SECRET=

# 선택
ADMIN_EMAILS=
RTMP_CALLBACK_TOKEN=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_TOKEN=
VOD_ENABLED=true
VITE_API_BASE_URL=http://localhost:8080
VITE_TOURNAMENT_CHANNEL_IDS=

# 요청 속도 제한(IP 하나당). 기본값은 api/src/main/resources/application.yaml 의 app.rate-limit 에 있다.
# RATE_LIMIT_ENABLED=true
